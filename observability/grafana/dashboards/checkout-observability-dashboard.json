          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.75, sum(rate(nop_checkout_stage_duration_ms_milliseconds_bucket{stage=\"finalize\",outcome=\"success\"}[$interval])) by (le)) or on() vector(0)",
          "legendFormat": "p75",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.90, sum(rate(nop_checkout_stage_duration_ms_milliseconds_bucket{stage=\"finalize\",outcome=\"success\"}[$interval])) by (le)) or on() vector(0)",
          "legendFormat": "p90",
          "range": true,
