%% Mermaid captures the logical structure, but the checked-in SVG/PNG are hand-laid out
%% for the presentation because Mermaid keeps collapsing this graph into a single lane.
flowchart TB
  subgraph T[" "]
    direction LR
    A([Confirm Order])
    B["CheckoutController"]
    C["OrderProcessingService"]

    A --> B --> C
  end

  subgraph S["Main stages"]
    direction LR
    D[Prepare]
    E[Payment]
    F[Persist Order]
    G[Move Items]
    H[Finalize]

    D --> E --> F --> G --> H
  end

  C --> D

  classDef entry fill:#dff4ff,stroke:#205375,stroke-width:2px,color:#102a43;
  classDef file fill:#fff4d6,stroke:#b45309,stroke-width:2px,color:#4a2d00;
  style T fill:none,stroke:none;

  class A entry;
  class B,C,D,E,F,G,H file;
